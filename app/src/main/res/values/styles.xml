<resources>
    <!-- L'app e' sempre scura: si legge bene e consuma meno sugli schermi OLED. -->
    <style name="AppTheme" parent="Theme.MaterialComponents">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnAccent</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/colorOnAccent</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="actionBarStyle">@style/AppTheme.ActionBar</item>
        <item name="materialButtonStyle">@style/AppTheme.Button</item>
    </style>

    <style name="AppTheme.ActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@color/colorBackground</item>
        <item name="elevation">0dp</item>
        <item name="titleTextStyle">@style/TextAppearance.AppCompat.Widget.ActionBar.Title</item>
    </style>

    <style name="AppTheme.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">8dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="AppTheme.Button.Tonal" parent="AppTheme.Button">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">@color/colorLine</item>
        <item name="strokeWidth">1dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Dark" />

    <style name="Accent.Teal" parent="">
        <item name="colorPrimary">#2DD4BF</item>
        <item name="colorPrimaryVariant">#2DD4BF</item>
        <item name="colorSecondary">#2DD4BF</item>
        <item name="colorAccent">#2DD4BF</item>
    </style>

    <style name="Accent.Blue" parent="">
        <item name="colorPrimary">#93C5FD</item>
        <item name="colorPrimaryVariant">#93C5FD</item>
        <item name="colorSecondary">#93C5FD</item>
        <item name="colorAccent">#93C5FD</item>
    </style>

    <style name="Accent.Violet" parent="">
        <item name="colorPrimary">#A78BFA</item>
        <item name="colorPrimaryVariant">#A78BFA</item>
        <item name="colorSecondary">#A78BFA</item>
        <item name="colorAccent">#A78BFA</item>
    </style>

    <style name="Accent.Orange" parent="">
        <item name="colorPrimary">#FB923C</item>
        <item name="colorPrimaryVariant">#FB923C</item>
        <item name="colorSecondary">#FB923C</item>
        <item name="colorAccent">#FB923C</item>
    </style>

    <style name="Accent.Pink" parent="">
        <item name="colorPrimary">#F472B6</item>
        <item name="colorPrimaryVariant">#F472B6</item>
        <item name="colorSecondary">#F472B6</item>
        <item name="colorAccent">#F472B6</item>
    </style>

    <style name="Accent.Green" parent="">
        <item name="colorPrimary">#4ADE80</item>
        <item name="colorPrimaryVariant">#4ADE80</item>
        <item name="colorSecondary">#4ADE80</item>
        <item name="colorAccent">#4ADE80</item>
    </style>

    <!--
        Colorblind overlay: uses Okabe-Ito blue (#0072B2) and orange (#E69F00),
        the most accessible combination for red-green colour blindness.
        Applied on top of any previously chosen accent.
    -->
    <style name="Theme.Colorblind" parent="">
        <item name="colorPrimary">#0072B2</item>
        <item name="colorPrimaryVariant">#0072B2</item>
        <item name="colorSecondary">#E69F00</item>
        <item name="colorAccent">#0072B2</item>
    </style>

    <!--
        LED theme overlay: replaces background with deep black and makes buttons
        outlined with a 2 dp neon border. Applied on top of any accent color.
    -->
    <style name="Theme.Led" parent="">
        <item name="android:colorBackground">@color/colorLedBackground</item>
        <item name="android:windowBackground">@color/colorLedBackground</item>
        <item name="android:statusBarColor">@color/colorLedBackground</item>
        <item name="android:navigationBarColor">@color/colorLedBackground</item>
        <item name="colorSurface">@color/colorLedSurface</item>
        <item name="materialButtonStyle">@style/AppTheme.Button.Led</item>
    </style>

    <style name="AppTheme.Button.Led" parent="AppTheme.Button">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeWidth">2dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

</resources>
