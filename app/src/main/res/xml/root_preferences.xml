<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/appearance">

        <ListPreference
            app:key="language"
            app:title="@string/language"
            app:defaultValue=""
            app:entries="@array/language_names"
            app:entryValues="@array/language_values"
            app:useSimpleSummaryProvider="true"
            />

        <ListPreference
            app:key="color"
            app:title="@string/color"
            app:defaultValue="blue"
            app:entries="@array/color_names"
            app:entryValues="@array/color_values"
            app:useSimpleSummaryProvider="true"
            />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/battery_and_data">

        <SwitchPreferenceCompat
            app:key="preserve_battery"
            app:title="@string/preserve_battery"
            app:defaultValue="false"
            app:summary="@string/preserve_battery_summary"
            />

        <SwitchPreferenceCompat
            app:key="preserve_data"
            app:title="@string/preserve_data"
            app:defaultValue="true"
            app:summary="@string/preserve_data_summary"
            />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/updates">

        <SwitchPreferenceCompat
            app:key="auto_update"
            app:title="@string/auto_update"
            app:defaultValue="true"
            app:summary="@string/auto_update_summary"
            />

        <Preference
            app:key="check_update"
            app:title="@string/check_update"
            />

    </PreferenceCategory>

</PreferenceScreen>
