<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/appearance">

        <ListPreference
            app:key="language"
            app:title="@string/language"
            app:defaultValue=""
            app:entries="@array/language_names"
            app:entryValues="@array/language_values"
            app:useSimpleSummaryProvider="true"
            />

        <ListPreference
            app:key="color"
            app:title="@string/color"
            app:defaultValue="blue"
            app:entries="@array/color_names"
            app:entryValues="@array/color_values"
            app:useSimpleSummaryProvider="true"
            />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/battery_and_data">

        <SwitchPreferenceCompat
            app:key="preserve_battery"
            app:title="@string/preserve_battery"
            app:defaultValue="false"
            app:summary="@string/preserve_battery_summary"
            />

        <SwitchPreferenceCompat
            app:key="preserve_data"
            app:title="@string/preserve_data"
            app:defaultValue="true"
            app:summary="@string/preserve_data_summary"
            />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/updates">

        <SwitchPreferenceCompat
            app:key="auto_update"
            app:title="@string/auto_update"
            app:defaultValue="true"
            app:summary="@string/auto_update_summary"
            />

        <Preference
            app:key="check_update"
            app:title="@string/check_update"
            />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/other_apps">

        <Preference
            app:key="ghost_generator"
            app:title="@string/ghost_generator"
            app:summary="@string/ghost_generator_summary"
            />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="developer"
        app:isPreferenceVisible="false"
        app:title="@string/developer">

        <ListPreference
            app:key="dev_bandwidth"
            app:title="@string/dev_bandwidth"
            app:defaultValue=""
            app:entries="@array/dev_bandwidth_names"
            app:entryValues="@array/dev_bandwidth_values"
            app:useSimpleSummaryProvider="true"
            />

        <ListPreference
            app:key="dev_connections"
            app:title="@string/dev_connections"
            app:defaultValue=""
            app:entries="@array/dev_connections_names"
            app:entryValues="@array/dev_connections_values"
            app:useSimpleSummaryProvider="true"
            />

        <ListPreference
            app:key="dev_disk"
            app:title="@string/dev_disk"
            app:defaultValue=""
            app:entries="@array/dev_disk_names"
            app:entryValues="@array/dev_disk_values"
            app:useSimpleSummaryProvider="true"
            />

        <ListPreference
            app:key="dev_threads"
            app:title="@string/dev_threads"
            app:defaultValue=""
            app:entries="@array/dev_threads_names"
            app:entryValues="@array/dev_threads_values"
            app:useSimpleSummaryProvider="true"
            />

        <Preference
            app:key="dev_copy_log"
            app:title="@string/dev_copy_log"
            app:summary="@string/dev_copy_log_summary"
            />

        <ListPreference
            app:key="dev_log"
            app:title="@string/dev_log"
            app:defaultValue="warn"
            app:entries="@array/dev_log_names"
            app:entryValues="@array/dev_log_values"
            app:useSimpleSummaryProvider="true"
            />

        <SwitchPreferenceCompat
            app:key="dev_block_screenshots"
            app:title="@string/dev_block_screenshots"
            app:summary="@string/dev_block_screenshots_summary"
            app:defaultValue="false"
            />

        <SwitchPreferenceCompat
            app:key="dev_animations"
            app:title="@string/dev_animations"
            app:defaultValue="true"
            />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/title_activity_about">

        <Preference
            app:key="build_number"
            app:title="@string/build_number"
            />

    </PreferenceCategory>

</PreferenceScreen>
