<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/appearance">

        <ListPreference
            app:key="language"
            app:title="@string/language"
            app:defaultValue=""
            app:entries="@array/language_names"
            app:entryValues="@array/language_values"
            app:useSimpleSummaryProvider="true"
            />

        <ListPreference
            app:key="color"
            app:title="@string/color"
            app:defaultValue="blue"
            app:entries="@array/color_names"
            app:entryValues="@array/color_values"
            app:useSimpleSummaryProvider="true"
            />

        <SwitchPreferenceCompat
            app:key="fullscreen"
            app:title="@string/fullscreen"
            app:summary="@string/fullscreen_summary"
            app:defaultValue="false"
            />

        <SwitchPreferenceCompat
            app:key="led_theme"
            app:title="@string/led_theme"
            app:summary="@string/led_theme_summary"
            app:defaultValue="false"
            />

        <ListPreference
            app:key="logo_style"
            app:title="@string/logo_style"
            app:defaultValue="freenet"
            app:entries="@array/logo_names"
            app:entryValues="@array/logo_values"
            app:useSimpleSummaryProvider="true"
            />

        <ListPreference
            app:key="logo_size"
            app:title="@string/logo_size"
            app:defaultValue="medium"
            app:entries="@array/logo_size_names"
            app:entryValues="@array/logo_size_values"
            app:useSimpleSummaryProvider="true"
            />

        <Preference
            app:key="logo_custom_pick"
            app:title="@string/logo_custom_pick"
            app:summary="@string/logo_custom_pick_summary"
            />

        <EditTextPreference
            app:key="app_custom_name"
            app:title="@string/app_custom_name"
            app:summary="@string/app_custom_name_summary"
            app:useSimpleSummaryProvider="true"
            />

        <ListPreference
            app:key="timer_color"
            app:title="@string/timer_color"
            app:defaultValue="secondary"
            app:entries="@array/timer_color_names"
            app:entryValues="@array/timer_color_values"
            app:useSimpleSummaryProvider="true"
            />

        <SwitchPreferenceCompat
            app:key="show_version"
            app:title="@string/show_version"
            app:defaultValue="true"
            />

        <SwitchPreferenceCompat
            app:key="show_timer"
            app:title="@string/show_timer"
            app:summary="@string/show_timer_summary"
            app:defaultValue="true"
            />

        <SwitchPreferenceCompat
            app:key="btn_river"
            app:title="@string/btn_river_pref"
            app:defaultValue="true"
            />

        <SwitchPreferenceCompat
            app:key="btn_pc"
            app:title="@string/btn_pc_pref"
            app:defaultValue="true"
            />

        <SwitchPreferenceCompat
            app:key="btn_web"
            app:title="@string/btn_web_pref"
            app:defaultValue="true"
            />

        <SwitchPreferenceCompat
            app:key="btn_sites"
            app:title="@string/btn_sites_pref"
            app:defaultValue="true"
            />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/web_pages">

        <ListPreference
            app:key="web_text_size"
            app:title="@string/web_text_size"
            app:defaultValue="100"
            app:entries="@array/web_text_size_names"
            app:entryValues="@array/web_text_size_values"
            app:useSimpleSummaryProvider="true"
            />

        <SwitchPreferenceCompat
            app:key="web_keep_screen"
            app:title="@string/web_keep_screen"
            app:summary="@string/web_keep_screen_summary"
            app:defaultValue="false"
            />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/battery_and_data">

        <SwitchPreferenceCompat
            app:key="saving_mode"
            app:title="@string/saving_mode"
            app:defaultValue="false"
            app:summary="@string/saving_mode_summary"
            />

        <SwitchPreferenceCompat
            app:key="preserve_battery"
            app:title="@string/preserve_battery"
            app:defaultValue="false"
            app:summary="@string/preserve_battery_summary"
            />

        <SwitchPreferenceCompat
            app:key="preserve_data"
            app:title="@string/preserve_data"
            app:defaultValue="true"
            app:summary="@string/preserve_data_summary"
            />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/privacy">

        <SwitchPreferenceCompat
            app:key="tor_mode"
            app:title="@string/tor_mode"
            app:defaultValue="false"
            app:summary="@string/tor_mode_summary"
            />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/host">

        <SwitchPreferenceCompat
            app:key="host_mode"
            app:title="@string/host_mode"
            app:defaultValue="false"
            app:summary="@string/host_mode_summary"
            />

        <Preference
            app:key="host_address"
            app:title="@string/host_address"
            app:summary="@string/host_address_summary"
            />

        <Preference
            app:key="proxy_password"
            app:title="@string/proxy_password"
            app:summary="@string/proxy_password_summary"
            />

        <Preference
            app:key="proxy_history"
            app:title="@string/proxy_history"
            app:summary="@string/proxy_history_summary"
            />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/updates">

        <SwitchPreferenceCompat
            app:key="auto_update"
            app:title="@string/auto_update"
            app:defaultValue="true"
            app:summary="@string/auto_update_summary"
            />


        <Preference
            app:key="update_background"
            app:title="@string/update_background"
            app:summary="@string/update_background_summary"
            />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/other_apps">

        <Preference
            app:key="ghost_official"
            app:title="@string/ghost_official"
            app:summary="@string/ghost_official_summary"
            />

        <Preference
            app:key="site_zip"
            app:title="@string/site_zip_entry"
            app:summary="@string/site_zip_entry_summary"
            />

        <Preference
            app:key="ghost_install"
            app:title="@string/ghost_install"
            app:summary="@string/ghost_install_summary"
            />

        <Preference
            app:key="ghost_generator"
            app:title="@string/ghost_generator"
            app:summary="@string/ghost_generator_summary"
            />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="developer"
        app:isPreferenceVisible="false"
        app:title="@string/developer">

        <ListPreference
            app:key="dev_bandwidth"
            app:title="@string/dev_bandwidth"
            app:defaultValue=""
            app:entries="@array/dev_bandwidth_names"
            app:entryValues="@array/dev_bandwidth_values"
            app:useSimpleSummaryProvider="true"
            />

        <ListPreference
            app:key="dev_connections"
            app:title="@string/dev_connections"
            app:defaultValue=""
            app:entries="@array/dev_connections_names"
            app:entryValues="@array/dev_connections_values"
            app:useSimpleSummaryProvider="true"
            />

        <ListPreference
            app:key="dev_disk"
            app:title="@string/dev_disk"
            app:defaultValue=""
            app:entries="@array/dev_disk_names"
            app:entryValues="@array/dev_disk_values"
            app:useSimpleSummaryProvider="true"
            />

        <ListPreference
            app:key="dev_threads"
            app:title="@string/dev_threads"
            app:defaultValue=""
            app:entries="@array/dev_threads_names"
            app:entryValues="@array/dev_threads_values"
            app:useSimpleSummaryProvider="true"
            />

        <Preference
            app:key="dev_new_invite"
            app:title="@string/dev_new_invite"
            app:summary="@string/dev_new_invite_summary"
            />

        <Preference
            app:key="dev_clear_web"
            app:title="@string/dev_clear_web"
            app:summary="@string/dev_clear_web_summary"
            />

        <Preference
            app:key="dev_copy_log"
            app:title="@string/dev_copy_log"
            app:summary="@string/dev_copy_log_summary"
            />

        <ListPreference
            app:key="dev_log"
            app:title="@string/dev_log"
            app:defaultValue="warn"
            app:entries="@array/dev_log_names"
            app:entryValues="@array/dev_log_values"
            app:useSimpleSummaryProvider="true"
            />

        <SwitchPreferenceCompat
            app:key="dev_block_screenshots"
            app:title="@string/dev_block_screenshots"
            app:summary="@string/dev_block_screenshots_summary"
            app:defaultValue="false"
            />

        <SwitchPreferenceCompat
            app:key="dev_animations"
            app:title="@string/dev_animations"
            app:defaultValue="true"
            />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/title_activity_about">

        <Preference
            app:key="news"
            app:title="@string/news"
            app:summary="@string/news_summary"
            />

        <Preference
            app:key="check_update"
            app:title="@string/check_update"
            />

        <Preference
            app:key="build_number"
            app:title="@string/build_number"
            />

    </PreferenceCategory>

</PreferenceScreen>
