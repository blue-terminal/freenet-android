<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP permesso verso:
  - 127.0.0.1 / localhost: nodo Freenet sul telefono
  - IP comuni LAN (192.168.x.x, 10.x.x.x): nodo Freenet su PC/Linux nella stessa rete
  L'IP del nodo remoto si configura manualmente in Web 7.0 → impostazioni.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- Nodo locale sul telefono -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Router/PC comuni 192.168.0.x -->
        <domain includeSubdomains="false">192.168.0.1</domain>
        <domain includeSubdomains="false">192.168.0.2</domain>
        <domain includeSubdomains="false">192.168.0.10</domain>
        <domain includeSubdomains="false">192.168.0.100</domain>
        <domain includeSubdomains="false">192.168.0.101</domain>
        <domain includeSubdomains="false">192.168.0.102</domain>
        <domain includeSubdomains="false">192.168.0.110</domain>
        <domain includeSubdomains="false">192.168.0.200</domain>
        <!-- Router/PC comuni 192.168.1.x (include 192.168.1.85 = questo PC) -->
        <domain includeSubdomains="false">192.168.1.1</domain>
        <domain includeSubdomains="false">192.168.1.2</domain>
        <domain includeSubdomains="false">192.168.1.10</domain>
        <domain includeSubdomains="false">192.168.1.50</domain>
        <domain includeSubdomains="false">192.168.1.80</domain>
        <domain includeSubdomains="false">192.168.1.81</domain>
        <domain includeSubdomains="false">192.168.1.82</domain>
        <domain includeSubdomains="false">192.168.1.83</domain>
        <domain includeSubdomains="false">192.168.1.84</domain>
        <domain includeSubdomains="false">192.168.1.85</domain>
        <domain includeSubdomains="false">192.168.1.86</domain>
        <domain includeSubdomains="false">192.168.1.87</domain>
        <domain includeSubdomains="false">192.168.1.88</domain>
        <domain includeSubdomains="false">192.168.1.89</domain>
        <domain includeSubdomains="false">192.168.1.90</domain>
        <domain includeSubdomains="false">192.168.1.100</domain>
        <domain includeSubdomains="false">192.168.1.101</domain>
        <domain includeSubdomains="false">192.168.1.102</domain>
        <domain includeSubdomains="false">192.168.1.110</domain>
        <domain includeSubdomains="false">192.168.1.120</domain>
        <domain includeSubdomains="false">192.168.1.150</domain>
        <domain includeSubdomains="false">192.168.1.200</domain>
        <domain includeSubdomains="false">192.168.1.254</domain>
        <!-- Router/PC comuni 192.168.2.x -->
        <domain includeSubdomains="false">192.168.2.1</domain>
        <domain includeSubdomains="false">192.168.2.100</domain>
        <!-- Reti 10.x.x.x (uffici, VPN) -->
        <domain includeSubdomains="false">10.0.0.1</domain>
        <domain includeSubdomains="false">10.0.0.2</domain>
        <domain includeSubdomains="false">10.0.0.100</domain>
        <domain includeSubdomains="false">10.0.1.1</domain>
        <!-- Reti 172.16-31.x.x -->
        <domain includeSubdomains="false">172.16.0.1</domain>
        <domain includeSubdomains="false">172.16.1.1</domain>
    </domain-config>
</network-security-config>
