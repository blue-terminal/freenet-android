<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/web_back"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/web_back"
            android:src="@drawable/ic_web_back" />

        <ImageButton
            android:id="@+id/web_home"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/web_home"
            android:src="@drawable/ic_web_home" />

        <TextView
            android:id="@+id/web_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/web_edit_url"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/web_edit_url"
            android:src="@drawable/ic_baseline_edit_24"
            app:tint="@color/colorTextSecondary"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>

    <WebView
        android:id="@+id/bootstrap_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
